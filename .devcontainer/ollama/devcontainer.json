{
    "name": "ollama",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "ollama",  // Refers to the backend service in docker-compose.yml
    "workspaceFolder": "/workspace",
    "forwardPorts": [
      5000
    ],
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace,type=bind"
      ],
    "customizations": {
        "vscode": {
            "extensions":[  
                "ms-python.python",
                "dbaeumer.vscode-eslint"
            ]
        }
    }
  }
  